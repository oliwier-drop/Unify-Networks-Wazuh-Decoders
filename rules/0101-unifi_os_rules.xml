<!--
  Ubiquiti UniFi OS consoles - rules 109300-109399

  Two shapes reach these rules. A netfilter line carries id set to the firewall
  action from the rule tag - A accept, D drop, R reject, RET return - plus the
  chain, the rule name from DESCR and the usual addresses. A daemon line carries
  unifi.daemon and unifi.message, and the ones with a specific decoder also
  carry id set to the literal event marker.

  The range sits at 109300-109399, just below ExtremeXOS (110100-110199) and
  well clear of 100000-100500, which is where local_rules.xml from Wazuh
  tutorials lands. A duplicate sid is skipped without a load error, so a
  console SSH login falls through to the catch-all and looks unhandled even
  though the decoder extracted id=Accepted perfectly. 100200 and 100300 both
  collided that way on this manager.

  The sshd rules matter more here than they look. A UniFi OS console repeats its
  hostname at the start of the message, which makes pre-decoding give up on the
  program name, and every built-in Wazuh decoder for sshd, sudo and su is keyed
  on program_name. None of them can fire on this hardware, so without these
  rules a console login is not merely unclassified - it is invisible.

  As in the device file, the catch-all uses level 1: level 0 is promoted to
  internal priority 99 while Wazuh builds the rule tree, and all alerting
  siblings use level 2 or higher.

  Install: copy to /var/ossec/etc/rules/ on the manager, then restart
  wazuh-manager. Remove any previous copy that still used 100200-100399.
-->

<group name="unifi,unifi_os,">

  <rule id="109300" level="0">
    <decoded_as>unifi-os</decoded_as>
    <description>UniFi OS console event</description>
  </rule>

  <!-- ================================================================ -->
  <!-- Firewall                                                         -->
  <!-- ================================================================ -->

  <rule id="109301" level="0">
    <if_sid>109300</if_sid>
    <regex type="pcre2">\[\w+-(A|RET)-\d+\]</regex>
    <description>UniFi OS firewall: $(unifi.fw_rule) allowed $(srcip) to $(dstip)</description>
    <group>firewall,</group>
  </rule>

  <rule id="109302" level="5">
    <if_sid>109300</if_sid>
    <regex type="pcre2">\[\w+-(D|R)-\d+\]</regex>
    <description>UniFi OS firewall: $(unifi.fw_rule) blocked $(srcip) to $(dstip):$(dstport)/$(protocol)</description>
    <group>firewall,firewall_drop,</group>
  </rule>

  <!-- A single source hitting a deny rule repeatedly is a scan, not a
       misconfigured client. -->
  <rule id="109303" level="10" frequency="15" timeframe="60">
    <if_matched_sid>109302</if_matched_sid>
    <same_source_ip />
    <description>UniFi OS firewall: $(srcip) blocked repeatedly - possible scan</description>
    <group>firewall_drop,recon,</group>
  </rule>

  <!-- Traffic dropped on the way out is more interesting than traffic dropped
       on the way in: something inside the network is trying to leave. -->
  <rule id="109304" level="7">
    <if_sid>109302</if_sid>
    <field name="unifi.in_iface">^br\d+$</field>
    <description>UniFi OS firewall: outbound traffic from $(srcip) blocked by $(unifi.fw_rule)</description>
    <group>firewall_drop,</group>
  </rule>

  <!-- ================================================================ -->
  <!-- Console administrative access over SSH                           -->
  <!-- ================================================================ -->

  <rule id="109310" level="4">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sshd\[\d+\]: Accepted </regex>
    <description>UniFi OS: SSH login for $(srcuser) from $(srcip) using $(unifi.auth_method)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="109311" level="5">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sshd\[\d+\]: Failed </regex>
    <description>UniFi OS: SSH authentication failed for $(srcuser) from $(srcip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="109312" level="5">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sshd\[\d+\]: Invalid user </regex>
    <description>UniFi OS: SSH attempt for non-existent user $(srcuser) from $(srcip)</description>
    <group>authentication_failed,invalid_login,</group>
  </rule>

  <rule id="109313" level="3">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sshd\[\d+\]: (?:Connection closed|Disconnected) </regex>
    <description>UniFi OS: SSH session with $(srcip) ended before authenticating</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="109314" level="8">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sshd\[\d+\]: error: maximum authentication attempts exceeded</regex>
    <description>UniFi OS: SSH authentication attempts exhausted for $(srcuser) from $(srcip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="109315" level="10" frequency="8" timeframe="120">
    <if_matched_sid>109311</if_matched_sid>
    <same_source_ip />
    <description>UniFi OS: repeated SSH authentication failures from $(srcip)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="109316" level="10" frequency="5" timeframe="120">
    <if_matched_sid>109312</if_matched_sid>
    <same_source_ip />
    <description>UniFi OS: SSH user enumeration from $(srcip)</description>
    <group>authentication_failures,invalid_login,</group>
  </rule>

  <!-- ================================================================ -->
  <!-- Privilege escalation on the console                              -->
  <!-- ================================================================ -->

  <rule id="109320" level="3">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sudo\[\d+\]: +\S+ : TTY=</regex>
    <description>UniFi OS: $(srcuser) ran a command as $(dstuser): $(unifi.command)</description>
    <group>syslog,sudo,</group>
  </rule>

  <rule id="109321" level="7">
    <if_sid>109300</if_sid>
    <regex type="pcre2">sudo\[\d+\]: +\S+ : \d+ incorrect password attempts</regex>
    <description>UniFi OS: sudo password failure for $(srcuser)</description>
    <group>authentication_failed,sudo,</group>
  </rule>

  <!-- ================================================================ -->
  <!-- Known-noisy services                                             -->
  <!-- ================================================================ -->

  <rule id="109330" level="0">
    <if_sid>109300</if_sid>
    <id type="pcre2">^(?:probe-runner|ui-probe)$</id>
    <description>UniFi OS: connectivity probe on $(unifi.probe)</description>
  </rule>

  <!-- ================================================================ -->
  <!-- Catch-all                                                        -->
  <!--                                                                  -->
  <!-- Level 1, for the same reason as 100190: level 0 is internally     -->
  <!-- promoted to priority 99, while alerting rules are level 2+.       -->
  <!-- ================================================================ -->

  <rule id="109390" level="1">
    <if_sid>109300</if_sid>
    <description>UniFi OS: $(unifi.daemon) on $(unifi.system_name) - $(unifi.message)</description>
  </rule>

  <rule id="109391" level="7">
    <if_sid>109390</if_sid>
    <match>fail|error|denied|refused|unauthorized</match>
    <description>UniFi OS: unhandled failure event from $(unifi.daemon)</description>
    <group>gpg13_4.12,</group>
  </rule>

  <rule id="109392" level="3">
    <if_sid>109390</if_sid>
    <description>UniFi OS: unhandled $(unifi.daemon) event - $(unifi.message)</description>
  </rule>

</group>
